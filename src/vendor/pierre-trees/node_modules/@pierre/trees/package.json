  "license": "apache-2.0",
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/components/web-components.js"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ],
      "react": [
        "dist/react/index.d.ts"
      ],
      "ssr": [
        "dist/ssr/index.d.ts"
      ],
      "web-components": [
        "dist/web-components.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-components": {
      "types": "./dist/web-components.d.ts",
      "import": "./dist/web-components.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "preact": "11.0.0-beta.0",
    "preact-render-to-string": "6.6.5",
    "@pierre/theming": "1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.2",
    "@pierre/vscode-icons": "0.0.9",
    "@playwright/test": "1.51.1",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@tsdown/css": "0.22.3",
    "@types/jsdom": "28.0.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.22",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "@pierre/tree-test-data": "0.0.1"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  }
