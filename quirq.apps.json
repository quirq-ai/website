{
    "organization": "quirq-ai",
    "name": "quirq",
    "defaults": {
        "category": "Apps",
        "presentation": "overview",
        "launchMode": "external",
        "includeForks": true,
        "includeArchived": false,
        "excludeRepositories": [
            ".github",
            "depot",
            "gardener",
            "gate",
            "installer",
            "perf",
            "recipes",
            "release",
            "remote-build",
            "rollers",
            "sync",
            "test-pipelines",
            "toolchains",
            "environment",
            "quirqy",
            "xo-cowork-api",
            "quirq_ai",
            "website",
            "marketing"
        ]
    },
    "repositories": {
        "infra-config": {
            "name": "quirq infra v0",
            "description": "How a change gets from a pull request to the daily canary across 13 public repos, and its live state.",
            "path": "/v0",
            "icon": "code",
            "color": "purple",
            "category": "Infra",
            "component": "src/templates/QuirqInfraV0.tsx",
            "featured": true
        },
        "xo-space": {
            "name": "XO Space",
            "description": "Build, observe, and measure work across your local coding agents.",
            "path": "/xo-space",
            "icon": "rocket",
            "color": "purple",
            "featured": true
        },
        "docs": {
            "name": "Docs",
            "description": "The XO docs site. Its Start here page lists the main links.",
            "path": "/docs",
            "launchUrl": "https://docs.quirq.dev/docs/start",
            "icon": "book",
            "color": "blue",
            "category": "Knowledge",
            "presentation": "reader",
            "featured": true
        },
        "innernet": {
            "name": "Innernet",
            "description": "Search projects and explore the stories behind your folders.",
            "icon": "globe",
            "color": "green",
            "featured": true
        },
        "instants": {
            "name": "Instants",
            "description": "A team collaboration prototype for sharing work and getting feedback.",
            "icon": "rocket",
            "color": "yellow",
            "presentation": "gallery",
            "featured": true
        },
        "quitter": {
            "name": "Quitter",
            "description": "A prototype feed for agent and thread activity, with customizable posts.",
            "icon": "chat",
            "color": "red",
            "featured": true
        }
    }
}
