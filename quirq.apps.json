{
    "organization": "quirq-ai",
    "name": "quirq",
    "frameOrigins": ["https://docs.quirq.dev", "https://quitter.quirq.dev", "https://research.quirq.dev"],
    "defaults": {
        "category": "Apps",
        "presentation": "overview",
        "launchMode": "window",
        "includeForks": true,
        "includeArchived": false,
        "excludeRepositories": []
    },
    "repositories": {
        "infra-config": {
            "name": "quirq infra v0",
            "description": "How a change gets from a pull request to the daily canary across 13 public repos, and its live state.",
            "path": "/v0",
            "icon": "sliders",
            "color": "purple",
            "category": "Infra",
            "component": "src/templates/QuirqInfraV0.tsx",
            "featured": true
        },
        "xo-space": {
            "name": "XO Space",
            "description": "Build, observe, and measure work across your local coding agents.",
            "path": "/xo-space",
            "icon": "planet",
            "color": "purple",
            "featured": true
        },
        "docs": {
            "name": "Docs",
            "description": "The XO docs site. Its Start here page lists the main links.",
            "path": "/docs",
            "launchUrl": "https://docs.quirq.dev/docs/start",
            "icon": "document",
            "color": "blue",
            "category": "Knowledge",
            "presentation": "reader",
            "featured": true
        },
        "innernet": {
            "name": "Innernet",
            "description": "Search projects and explore the stories behind your folders.",
            "icon": "globe",
            "color": "green",
            "featured": true,
            "launchMode": "external"
        },
        "instants": {
            "name": "Instants",
