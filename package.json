{
    "name": "quirq-home-base",
    "description": "A customizable desktop for apps from the quirq GitHub organization.",
    "version": "1.0.0",
    "author": "quirq",
    "license": "SEE LICENSE IN LICENSING.md",
    "engines": {
        "node": "24.x"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/quirq-ai/website"
    },
    "keywords": [
        "gatsby"
    ],
    "private": true,
    "scripts": {
        "apps:sync": "node scripts/sync-quirq-apps.mjs",
        "apps:check": "node scripts/sync-quirq-apps.mjs --check",
        "apps:prune": "node scripts/sync-quirq-apps.mjs --prune",
        "apps:test": "node --test scripts/quirq-catalog.test.mjs",
        "projects:sync": "node scripts/sync-quirq-projects.mjs",
        "projects:check": "node scripts/sync-quirq-projects.mjs --check",
        "build": "gatsby build",
        "start": "gatsby develop -H 127.0.0.1 -p 8001",
        "serve": "gatsby serve",
        "clean": "gatsby clean",
        "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/quirq-catalog.test.mjs scripts/quirq-phases.test.mjs scripts/quirq-source.test.mjs gatsby/quirqRoutes.test.cjs src/lib/quirqDocs.test.ts src/lib/quirqReadmeLinks.test.ts src/lib/externalLinks.test.ts src/lib/frameCheck.test.ts src/lib/quirqRoles.test.ts",
        "test:app-routes": "node --test gatsby/quirqRoutes.test.cjs",
        "prepare": "husky",
        "source:check": "node scripts/check-quirq-source.mjs",
        "prebuild": "pnpm apps:check && pnpm projects:check && pnpm source:check",
        "format": "prettier --write \"{src,scripts,gatsby}/**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\" \"*.{js,jsx,ts,tsx,json,yaml}\""
    },
    "dependencies": {
        "@fontsource-variable/ibm-plex-sans": "^5.2.8",
        "@gatsbyjs/reach-router": "^1.3.9",
        "@headlessui/react": "^1.7.13",
        "@posthog/icons": "0.36.6",
        "@radix-ui/react-portal": "^1.1.9",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-tabs": "^1.1.4",
        "@tailwindcss/container-queries": "^0.1.1",
        "@typescript-eslint/eslint-plugin": "^4.20.0",
        "clsx": "^2.0.0",
        "dotenv": "^10.0.0",
        "framer-motion": "^10.18.0",
        "gatsby": "4.25.9",
        "gatsby-cli": "^4.20.0",
        "gatsby-plugin-page-creator": "4.25.0",
        "gatsby-plugin-postcss": "^5.20.0",
        "gatsby-plugin-react-helmet": "^5.20.0",
        "github-slugger": "^1.4.0",
        "lodash": "^4.17.21",
        "mark.js": "^8.11.1",
        "mermaid": "^11.4.1",
        "prism-react-renderer": "^1.3.5",
        "qs": "^6.11.1",
        "radix-ui": "^1.1.3",
        "react": "^18.2.0",
        "react-confetti": "^6.1.0",
        "react-dom": "^18.2.0",
        "react-helmet": "^5.2.1",
        "react-markdown": "^8.0.4",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^5.0.1",
        "remark-gfm": "^3.0.1",
        "tailwind-merge": "^2.0.0",
        "typescript": "^4.0.2",
        "fs-extra": "^10.1.0",
        "gatsby-link": "^4.25.0",
        "gatsby-react-router-scroll": "^5.25.0",
        "gatsby-script": "^1.10.0",
        "mitt": "^1.2.0",
        "prop-types": "^15.8.1",
        "shallow-compare": "^1.2.2",
        "gatsby-legacy-polyfills": "^2.25.0",
        "deepmerge": "^4.3.1",
        "node-html-parser": "^5.4.2",
        "event-source-polyfill": "1.0.25"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/typography": "^0.5.16",
        "@types/mark.js": "^8.11.12",
        "@types/react": "^16.0.0",
        "@types/react-dom": "^18.0.6",
        "@types/react-helmet": "^6.1.0",
        "@typescript-eslint/parser": "^4.5.0",
        "autoprefixer": "^10.4.7",
        "eslint": "^7.9.0",
        "eslint-plugin-react": "^7.20.6",
        "husky": "9.1.7",
        "lint-staged": "^10.2.12",
        "markdownlint-cli2": "0.19.0",
        "postcss": "^8.4.14",
        "prettier": "^2.1.0",
        "tailwindcss": "^3.4.14",
        "babel-loader": "^8.2.2"
    },
    "lint-staged": {
        "*.{html,js,ts,tsx,json,yml,css,scss}": "prettier --write --no-error-on-unmatched-pattern",
        "*.{js,ts,tsx}": "eslint",
        "*.{md,mdx}": "markdownlint-cli2 --fix"
    },
    "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b",
    "pnpm": {
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "core-js",
            "core-js-pure",
            "es5-ext",
            "esbuild",
            "fsevents",
            "gatsby",
            "gatsby-cli",
            "gatsby-telemetry",
            "husky",
            "lmdb",
            "msgpackr-extract",
            "sharp"
        ],
        "overrides": {
            "undici": "5.26.3"
        }
    }
}
